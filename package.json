{
  "name": "workforge-frontend-react",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "start": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc -b && vite build",
